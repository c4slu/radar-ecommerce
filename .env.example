# Supabase (Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Postgres: botão Connect > Session pooler (porta 5432).
# Não use o Transaction pooler (6543): ele trava com queries em paralelo.
DATABASE_URL=postgresql://postgres.xxxx:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres
# Único e-mail autorizado a entrar no app
ALLOWED_EMAIL=voce@exemplo.com
# Telegram (fase 3)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Mercado Livre (fase 2)
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# Shopee (API de afiliados: affiliate.shopee.com.br > Open API)
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=
