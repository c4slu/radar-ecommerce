# Supabase (Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Postgres: botão Connect > Session pooler (porta 5432).
# Não use o Transaction pooler (6543): ele trava com queries em paralelo.
DATABASE_URL=postgresql://postgres.xxxx:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres
# Único e-mail autorizado a entrar no app
ALLOWED_EMAIL=voce@exemplo.com
# Telegram (fase 3)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Mercado Livre (fase 2)
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# Shopee (API de afiliados: affiliate.shopee.com.br > Open API)
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=
# Ambiente: "dev" no .env.local (banco radar-dev). Em produção (Vercel) não defina.
# RADAR_ENV=dev
# Tamanho do pool de conexões por processo (o Session pooler grátis aceita 15 no total)
# DB_POOL_MAX=3
# Retorno do OAuth do ML no ambiente local (no .env.local). O ML recusa localhost;
# radar.localtest.me aponta para 127.0.0.1. Na Vercel use a URL de produção.
# ML_REDIRECT_URI=https://radar.localtest.me:3000/api/ml/callback
# Fornecedores: CJ Dropshipping (My CJ > API > API Key)
CJ_API_KEY=
# AliExpress Open Platform (afiliados) — após aprovação do app
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=
